# Database (PostgreSQL)
DATABASE_URL="postgresql://aavya:aavya@localhost:5432/aavyas_home?schema=public"

# Public site URL (used for canonical URLs, sitemap, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Session cookies are signed/hashed server side; this secret salts token hashing and reset tokens.
AUTH_SECRET="replace-with-output-of: openssl rand -base64 32"

# Image storage: "local" (dev only, writes to public/uploads) or "s3" (S3-compatible: AWS S3, Cloudflare R2, MinIO, Backblaze)
STORAGE_DRIVER="local"
S3_ENDPOINT=""            # leave empty for AWS S3; set for R2/MinIO e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""     # public URL prefix for objects, e.g. https://cdn.example.com

# Email (Resend). If RESEND_API_KEY is empty, emails are skipped and logged.
RESEND_API_KEY=""
EMAIL_FROM="Aavya's Home <bookings@example.com>"

# Used only by scripts/create-admin.ts (first Super Admin)
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
